   "source": [
    "# Label Change Visualization (6 images)\n",
    "- 아래 리스트에 라벨 변경된 이미지 6개를 지정하세요.\n",
    "- 각 이미지를 2x3 그리드로 출력하고, 캡션에 `ID (old -> new)`를 표시합니다.\n",
    "- 요약 표(테이블) PNG/CSV도 함께 저장합니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import time\n",
    "import cv2\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 1) 여기에 라벨 변경된 6개를 입력하세요 (ID는 파일명 기준)\n",
    "label_changes = [\n",
    "    # 예시: {'id': 'be53872196b3ae1d.jpg', 'old': 5, 'new': 3},\n",
    "    # {'id': 'f0fc4e2f239e236b.jpg', 'old': 5, 'new': 13},\n",
    "]\n",
    "assert len(label_changes) == 6, 'label_changes는 정확히 6개를 넣어주세요.'\n",
    "\n",
    "# 2) 이미지 탐색 경로(필요시 추가)\n",
    "search_dirs = [\n",
    "    Path('data/processed/offline_aug/images'),\n",
    "    Path('data/raw/train'),\n",
    "    Path('data/raw/test'),\n",
    "]\n",
    "\n",
    "def find_image_path(img_id: str) -> Path:\n",
    "    for d in search_dirs:\n",
    "        p = d / img_id\n",
    "        if p.exists():\n",
    "            return p\n",
    "    raise FileNotFoundError(f'이미지를 찾을 수 없음: {img_id}')\n",
    "\n",
    "def imread_rgb(path: Path) -> np.ndarray:\n",
    "    img = cv2.imread(str(path), cv2.IMREAD_COLOR)\n",
    "    if img is None:\n",
    "        raise FileNotFoundError(str(path))\n",
    "    return cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "\n",
    "# 3) 출력 디렉토리\n",
    "ts = time.strftime('%Y%m%d-%H%M%S')\n",
    "out_dir = Path('reports/summary') / ts\n",
    "out_dir.mkdir(parents=True, exist_ok=True)\n",
    "grid_path = out_dir / 'label_changes_grid.png'\n",
    "table_png_path = out_dir / 'label_changes_table.png'\n",
    "table_csv_path = out_dir / 'label_changes_table.csv'\n",
    "\n",
    "# 4) 그리드 시각화(2x3)\n",
    "fig, axes = plt.subplots(2, 3, figsize=(12, 8))\n",
    "axes = axes.flatten()\n",
    "for ax, item in zip(axes, label_changes):\n",
    "    p = find_image_path(item['id'])\n",
    "    img = imread_rgb(p)\n",
    "    ax.imshow(img)\n",
    "    ax.axis('off')\n",
    "    ax.set_title(f"{item['id']} ({item['old']} -> {item['new']})", fontsize=10)\n",
    "plt.tight_layout()\n",
    "plt.savefig(grid_path, dpi=150)\n",
    "plt.close()\n",
    "\n",
    "# 5) 테이블(표) 생성 및 저장\n",
    "df = pd.DataFrame(label_changes)[['id','old','new']]\n",
    "df.to_csv(table_csv_path, index=False)\n",
    "fig, ax = plt.subplots(figsize=(10, 2.5))\n",
    "ax.axis('off')\n",
    "tbl = ax.table(cellText=df.values, colLabels=df.columns, loc='center')\n",
    "tbl.auto_set_font_size(False)\n",
    "tbl.set_fontsize(9)\n",
    "tbl.scale(1, 1.2)\n",
    "plt.tight_layout()\n",
    "plt.savefig(table_png_path, dpi=150)\n",
    "plt.close()\n",
    "\n",
    "print('Saved:', grid_path)\n",
    "print('Saved:', table_png_path)\n",
    "print('Saved:', table_csv_path)\n"
   ]
  }
 ],
